{
  "app": {
    "signingConfigs": [
      {
        "name": "default",
        "type": "HarmonyOS",
        "material": {
          "certpath": "./signing/app-debug-cert.cer",
          "keyAlias": "oh-app-key-v1",
          "keyPassword": "REPLACE_WITH_YOUR_ENCRYPTED_KEY_PASSWORD",
          "profile": "./signing/profile.p7b",
          "signAlg": "SHA256withECDSA",
          "storeFile": "./signing/app.jks",
          "storePassword": "REPLACE_WITH_YOUR_ENCRYPTED_STORE_PASSWORD"
        }
      }
    ],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "compatibleSdkVersion": "5.0.0(12)",
        "targetSdkVersion": "5.0.0(12)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "arkOptions": {
            "buildProfileFields": {}
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
